{
  "name": "superdoc-canonical-collaboration-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "test": "node --test src/config.test.js src/agent.test.js src/job-service.test.js src/streaming.test.js src/streaming-concurrency.test.js src/collaboration/*.test.js src/collaboration/**/*.test.js src/rooms/*.test.js",
    "test:collaboration": "node --test src/collaboration/*.test.js src/collaboration/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/multipart": "9.2.1",
    "@fastify/websocket": "11.2.0",
    "@hocuspocus/server": "2.15.3",
    "@superdoc/sdk": "2.23.0",
    "@xmldom/xmldom": "0.9.12",
    "citeproc": "2.4.63",
    "fastify": "5.12.4",
    "jszip": "3.10.1",
    "openai": "5.19.1",
    "yjs": "13.6.31"
  }
}

{
  "display_information": {
    "name": "Demo Bot",
    "description": "Find SuperDoc examples or build a focused demo with a private preview and source download.",
    "background_color": "#1355ff"
  },
  "features": {
    "bot_user": {
      "display_name": "Demo Bot",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "im:history",
        "im:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://demo-bot-int-production.up.railway.app/slack/events"
    },
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups"
      ],
      "request_url": "https://demo-bot-int-production.up.railway.app/slack/events"
    }
  }
}

# Server-only credentials. Copy to .env.local; never put this key in browser code.
OPENAI_API_KEY=
DEMO_AGENT_MODEL=gpt-5-mini
# Daily usage ceiling. Worst-case holds are reconciled against reported actual tokens.
DEMO_AGENT_DAILY_TOKENS=150000
# One network cannot consume the shared daily allowance.
DEMO_AGENT_IP_DAILY_TOKENS=50000
# Customer gallery: set these server-side to proxy the deployed external service.
# DEMO_AGENT_BACKEND_URL=https://demo-bot-ext-production.up.railway.app
# DEMO_AGENT_PROXY_TOKEN=
# Backend deployment label (does not change features).
DEMO_AGENT_INSTANCE=demo-bot-ext
# Production service: persistent disk, one replica, and matching Pages proxy secret.
# DEMO_AGENT_DATA_DIR=/data/demo-agent
# DEMO_AGENT_ORIGINS=https://demos.superdoc.dev
# DEMO_AGENT_PROXY_TOKEN=
# Optional Slack app (signed HTTP events). See agent/SLACK.md; never commit real tokens.
# DEMO_AGENT_SLACK_ENABLED=1
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_TEAM_ID=T...
# DEMO_AGENT_PUBLIC_URL=https://demos.superdoc.dev
# SLACK_ALLOWED_USERS=U...,U...
# SLACK_ALLOWED_CHANNELS=C...,C...
